COMPOSE_PROJECT_NAME=libro-trabajo
APP_PORT=8000
# Completar localmente en el servidor. No subir el archivo .env a Git.
APP_ENV=production
APP_IMAGE=librodetrabajo-app:server
APP_BIND_ADDRESS=127.0.0.1
POSTGRES_DB=operativa
POSTGRES_USER=operativa
# Contraseña aleatoria hexadecimal, para evitar caracteres reservados en la URL.
POSTGRES_PASSWORD=
# Secreto aleatorio de al menos 32 caracteres.
APP_SECRET=
ADMIN_USER=admin
# Contraseña única de al menos 12 caracteres, no usar valores de ejemplo.
ADMIN_PASSWORD=
# Reemplazar las tres referencias por el dominio real con HTTPS.
PUBLIC_BASE_URL=https://libro.ejemplo.com
ALLOWED_HOSTS=localhost,127.0.0.1,libro.ejemplo.com
ALLOWED_ORIGINS=https://libro.ejemplo.com
SESSION_SECONDS=43200
SESSION_IDLE_SECONDS=1800
ENABLE_API_DOCS=false
BACKUP_INTERVAL_SECONDS=900
BACKUP_MAX_AGE_SECONDS=5400
