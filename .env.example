APP_ENV=production
POSTGRES_DB=operativa
POSTGRES_USER=operativa
POSTGRES_PASSWORD=<GENERAR_CON_EL_PROCEDIMIENTO_DE_SECURITY_MD>
DATABASE_URL=postgresql://operativa:<MISMA_CLAVE_POSTGRES_CODIFICADA_PARA_URL>@db:5432/operativa
APP_SECRET=<GENERAR_32_BYTES_ALEATORIOS_COMO_MINIMO>
APP_IMAGE=librodetrabajo-app:1.30.0
APP_BIND_ADDRESS=127.0.0.1
PUBLIC_BASE_URL=https://<NOMBRE_DNS_DEL_SERVIDOR>
OSM_TILE_USER_AGENT=LibroDeTrabajo/1.0 (+https://<NOMBRE_DNS_DEL_SERVIDOR>)
SESSION_SECONDS=43200
SESSION_IDLE_SECONDS=1800
ALLOWED_HOSTS=localhost,127.0.0.1,<NOMBRE_DNS_DEL_SERVIDOR>
ALLOWED_ORIGINS=https://<NOMBRE_DNS_DEL_SERVIDOR>
MAX_BODY_BYTES=1048576
ENABLE_API_DOCS=false
ADMIN_USER=admin
ADMIN_PASSWORD=<DEFINIR_CLAVE_INICIAL_DE_12_CARACTERES_O_MAS>
BACKUP_INTERVAL_SECONDS=900
